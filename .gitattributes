# Normalise line endings in the repo, check out native on each platform.
* text=auto eol=lf

# Binary — never touch these.
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.woff binary
*.woff2 binary

# Lockfiles are generated; keep them out of diffs and merge noise.
package-lock.json -diff linguist-generated
